+V3D dr_vel_body(0.0, 0.0, 0.0);
+
+// Leg-odometry velocity observation.
+//
+// Measured on office_corridor_02: Point-LIO exceeds the 0.75 m/s platform maximum in
+// 30 % of scans, and during t=172.6-177.5 s it ran away to 5.4 m/s while leg odometry
+// correctly reported normal walking. Velocity is an explicit state here, so the
+// cheapest correction is to observe it directly.
+//
+// mode 1: full vector. Most informative, but rotating the body-frame measurement into
+//         the world uses s.rot, which is itself degraded while the filter is diverging.
+// mode 2: speed magnitude only, applied along the filter's own velocity direction.
+//         Attitude-invariant, and the in-filter analogue of the offline "pure scale-DR"
+//         variant that recovered 88 % / 73 % on our two datasets.
+void h_model_DR_output(state_output &s, esekfom::dyn_share_modified<double> &ekfom_data)
+{
+    ekfom_data.dr_valid = false;
+    ekfom_data.z_DR.setZero();
+    ekfom_data.R_DR << dr_vel_cov, dr_vel_cov, dr_vel_cov;
+
+    const double meas_speed = dr_vel_body.norm();
+    // leg odometry tops out at the platform maximum; anything above it is a fault,
+    // not a measurement, so refuse rather than inject it.
+    if (!std::isfinite(meas_speed) || meas_speed > dr_max_speed) return;
+
+    if (dr_mode == 1)
+    {
+        ekfom_data.z_DR = s.rot * dr_vel_body - s.vel;
+        ekfom_data.dr_valid = true;
+    }
+    else if (dr_mode == 2)
+    {
+        const double est_speed = s.vel.norm();
+        if (est_speed < 1e-6)
+        {
+            // no direction to scale; still pull a standing robot towards rest
+            ekfom_data.z_DR = -s.vel;
+        }
+        else
+        {
+            ekfom_data.z_DR = (s.vel / est_speed) * meas_speed - s.vel;
+        }
+        ekfom_data.dr_valid = true;
+    }
+    else if (dr_mode == 3)
+    {
+        // EXPERIMENT (2026-10-13): mode 1 without its direct world-z row (huge noise, zero
+        // residual). The x/y rows can STILL move v_z, pos_z and attitude through P's
+        // cross-covariances, so this removes only the direct vertical channel -- a null
+        // result here does not clear the z channel (independently reviewed).
+        ekfom_data.z_DR = s.rot * dr_vel_body - s.vel;
+        ekfom_data.z_DR(2) = 0.0;
+        ekfom_data.R_DR(2) = 1e12;
+        ekfom_data.dr_valid = true;
+    }
+    else if (dr_mode == 4)
+    {
+        // EXPERIMENT (2026-10-13): body-frame residual with its attitude Jacobian.
+        //   y = v_leg (body),  h(x) = R^T v,  z = y - h(x)
+        // IKFoM perturbs SO3 on the right (R <- R Exp(dtheta)), so
+        //   Exp(dtheta)^T w ~ w + [w]x dtheta   with w = R^T v
+        //   =>  H_rot = [R^T v]x  (state cols 3..5),  H_vel = R^T  (cols 12..14).
+        // Unlike mode 1, a disagreement can now be explained by attitude as well as
+        // velocity, so DR can correct tilt instead of fighting it.
+        const M3D Rt = s.rot.conjugate().normalized().toRotationMatrix();
+        const V3D w = Rt * s.vel;
+        M3D wx;
+        wx << SKEW_SYM_MATRX(w);
+        ekfom_data.H_DR.setZero();
+        ekfom_data.H_DR.block<3, 3>(0, 3) = wx;
+        ekfom_data.H_DR.block<3, 3>(0, 12) = Rt;
+        ekfom_data.z_DR = dr_vel_body - w;
+        ekfom_data.dr_full = true;
+        ekfom_data.dr_valid = true;
+    }
+}
